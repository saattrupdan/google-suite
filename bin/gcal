#!/usr/bin/env bash
# Terminal launcher. Usage:
#   gcal                      # open (or activate) the app
#   gcal --url <url>          # first tab shows <url> (only on a cold start)
#   gcal --selftest           # offline checks
set -euo pipefail
APP_NAME="Google Suite"

# Name lookup can resolve to the build tree instead of the installed copy, so
# prefer the explicit /Applications path.
if [[ -d "/Applications/$APP_NAME.app" ]]; then
  exec open "/Applications/$APP_NAME.app" --args "$@"
elif [[ -x "$HOME/gitsky/gcal-app/$APP_NAME.app/Contents/MacOS/$APP_NAME" ]]; then
  exec "$HOME/gitsky/gcal-app/$APP_NAME.app/Contents/MacOS/$APP_NAME" "$@"
else
  echo "$APP_NAME is not installed. Run ./build.sh && ./install.sh in ~/gitsky/gcal-app" >&2
  exit 1
fi
